# Aplicación
NODE_ENV=development
PAYLOAD_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (compose construye DATABASE_URL internamente con estos valores)
POSTGRES_DB=tesis
POSTGRES_USER=tesis
POSTGRES_PASSWORD=cambiar-por-una-contrasena-larga-y-aleatoria

# Requerido para correr `npm run dev` en el host (fuera de Docker)
DATABASE_URL=postgres://tesis:cambiar-por-una-contrasena-larga-y-aleatoria@localhost:5432/tesis
